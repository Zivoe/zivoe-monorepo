NEXT_PUBLIC_ENV=
NEXT_PUBLIC_CHAIN_ENV=
NODE_ENV=

NEXT_PUBLIC_MAINNET_ALCHEMY_KEY=
NEXT_PUBLIC_TESTNET_ALCHEMY_KEY=
# Optional extra Pharos provider; see docs/runbooks/chain-data-fallbacks.md.
NEXT_PUBLIC_PHAROS_RPC_FALLBACK_URL=

QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

NEXT_PUBLIC_DYNAMIC_ENV_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
# Production only: server-side flag evaluation (the `kyc` flag gates the KYC surfaces).
# A PostHog project secret API key with the `feature_flag:read` scope, never the `phc_` key.
POSTHOG_FEATURE_FLAGS_KEY=

SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_INTERCOM_APP_ID=
ZIVOE_API_KEY=
CHAINALYSIS_API_KEY=

# Persona (KYC) — sandbox keys on previews, production keys in production
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_VERSION_ID=
PERSONA_TEMPLATE_ID=
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=

# Database/Auth (better-auth)
DATABASE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_TOKEN_SECRET=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

BEEHIIV_PUBLICATION_ID=
BEEHIIV_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAINALYSIS_CHAT_ID=
TELEGRAM_ONBOARDING_CHAT_ID=
TELEGRAM_PERSONA_CHAT_ID=
TELEGRAM_TXS_CHAT_ID=

ZAPPER_API_KEY=

# Optional: only for local dev with `npx @upstash/qstash-cli@latest dev`
QSTASH_URL=

# Optional: Vercel Preview only — lets an agent sign in via POST /api/agent-sign-in (see docs/runbooks/agent-sign-in.md)
AGENT_SIGN_IN_SECRET=

# Optional: 32+ characters, same value as in the Lighthouse project — signs the pass cookie that lets onboarded users view Lighthouse.
# Set it for Production only, with a value used nowhere else: a Preview holding it could issue passes that production Lighthouse accepts.
LIGHTHOUSE_PASS_SECRET=
