{
  "extends": "@zivoe/ts-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      { "name": "next" },
      {
        "name": "gql.tada/ts-plugin",
        "schema": "../../packages/centrifuge-indexer/schema.graphql",
        "tadaOutputLocation": "../../packages/centrifuge-indexer/src/graphql-env.d.ts"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@zivoe/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "postcss.config.cjs",
    "prettier.config.cjs"
  ],
  "exclude": ["node_modules", "archived"]
}
