{
  "name": "@zivoe/ui",
  "version": "0.0.0",
  "exports": {
    "./assets/*": "./src/assets/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./core/common/*": "./src/core/common/*.tsx",
    "./core/field/*": "./src/core/field/*.tsx",
    "./core/*": "./src/core/*/index.tsx",
    "./globals.css": "./src/globals.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint": "eslint ./src/",
    "format": "prettier --write \"**/*.{ts,tsx,mdx}\"",
    "check-types": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@radix-ui/react-portal": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@storybook/react": "^8.5.8",
    "input-otp": "^1.4.2",
    "next": "15.6.0-canary.60",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^0.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@zivoe/eslint-config": "workspace:*",
    "@zivoe/prettier-config": "workspace:*",
    "@zivoe/ts-config": "workspace:*",
    "eslint": "^9.21.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "react-aria-components": "^1.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-react-aria-components": "^1.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.57.1"
  },
  "overrides": {
    "react-is": "^19.0.0"
  }
}
